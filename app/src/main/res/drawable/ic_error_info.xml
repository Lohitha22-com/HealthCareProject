<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:width="50dp"
        android:height="50dp">
        <shape android:shape="oval">
            <solid android:color="#1976D2" />
            <stroke
                android:width="1dp"
                android:color="#0D47A1" />
        </shape>
    </item>

    <item
        android:width="36dp"
        android:height="16dp"
        android:top="3dp"
        android:left="7dp"
        android:layout_gravity="top|center_horizontal">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <item
        android:width="36dp"
        android:height="16dp"
        android:bottom="3dp"
        android:left="7dp"
        android:gravity="bottom">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="360"
                android:startColor="#00FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#E6FFFFFF"/>
        </shape>
    </item>

    <item
        android:width="50dp"
        android:height="50dp">
        <vector
            android:width="50dp"
            android:height="50dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:pivotY="12"
                android:pivotX="12"
                android:scaleX="1.3"
                android:scaleY="1.3">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M11.5,17 h1.5 v-5.5 h-1.5 z M10,17 h4.5 v-1.0 h-4.5 z M10.5,11.5 h2.5 v-1 h-1.5 c-0.8,0 -1,0.5 -1,1 z M10.8,8 a1.2,1.2 0,1 0,2.4 0 a1.2,1.2 0,1 0,-2.4 0 z" />
            </group>
        </vector>
    </item>

</layer-list>