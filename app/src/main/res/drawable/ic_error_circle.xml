<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:width="30dp"
        android:height="30dp"
        android:top="0dp"
        android:left="0dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="25"
                android:centerX="0.32"
                android:centerY="0.28"
                android:startColor="#EF5350"
                android:centerColor="#D32F2F"
                android:endColor="#D32F2F" />
            <stroke
                android:width="0.5dp"
                android:color="#8B0000" />
        </shape>
    </item>

    <item
        android:width="20dp"
        android:height="10dp"
        android:top="1dp"
        android:left="4dp">
        <rotate
            android:fromDegrees="-10"
            android:toDegrees="-10"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="oval">
                <gradient
                    android:type="linear"
                    android:angle="9"
                    android:startColor="#B3FFFFFF"
                    android:centerColor="#33FFFFFF"
                    android:endColor="#00FFFFFF" />
            </shape>
        </rotate>
    </item>

    <item android:width="20dp"
        android:height="8dp"
        android:bottom="2.5dp"
        android:left="4dp"
        android:gravity="bottom">
        <rotate
            android:fromDegrees="10"
            android:toDegrees="10"
            android:pivotX="40%"
            android:pivotY="40%">
        <shape android:shape="oval">
            <gradient android:type="linear"
                android:angle="90"
                android:startColor="#B3FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
        </rotate>
    </item>

    <item
        android:width="30dp"
        android:height="30dp"
        android:top="0dp"
        android:left="0dp">
        <vector
            android:width="30dp"
            android:height="30dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:pivotX="12"
                android:pivotY="12"
                android:scaleX="1.3"
                android:scaleY="1.3">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M15.59,7L12,10.59 8.41,7 7,8.41 10.59,12 7,15.59 8.41,17 12,13.41 15.59,17 17,15.59 13.41,12 17,8.41z" />
            </group>
        </vector>
    </item>

</layer-list>